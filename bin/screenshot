#!/usr/bin/env bash
mode="${1:-region}"

tmp="$(mktemp --suffix=.png /tmp/screenshot-XXXXXX)"
thumb="$(mktemp --suffix=.png /tmp/screenshot-thumb-XXXXXX)"
trap 'rm -f "$tmp" "$thumb"' EXIT

hyprshot -m "$mode" --raw > "$tmp"

[[ -s "$tmp" ]] || exit 0

wl-copy --type image/png < "$tmp"

magick "$tmp" -resize 128x128 "$thumb"

action="$(notify-send --wait -i "$thumb" -t 8000 \
  -A "default=Editar no Satty" \
  "Screenshot copiada" "Clique para editar")"

if [[ "$action" == "default" ]]; then
  satty --filename "$tmp" --copy-command wl-copy --early-exit \
        --actions-on-enter save-to-clipboard
fi