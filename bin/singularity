
#!/usr/bin/env bash

set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

export SINGULARITY_ROOT="$ROOT_DIR"

source "$ROOT_DIR/bin/lib/theme.sh"

usage() {
    cat <<'EOF'
Singularity - Desktop theme manager

Usage:
  singularity theme set <name>
  singularity theme next
  singularity theme previous
  singularity theme current
  singularity theme list

Options:
  -h, --help       Show this help message
  -v, --version    Show version information
EOF
}

main() {
    if (($# == 0)); then
        usage
        return 0
    fi

    case "$1" in
        theme)
            shift

            if (($# == 0)); then
                echo "Error: missing theme subcommand." >&2
                return 2
            fi

            local command="$1"
            shift

            case "$command" in
                set)
                    theme_set "$@"
                    ;;
                next)
                    theme_next "$@"
                    ;;
                previous)
                    theme_previous "$@"
                    ;;
                current)
                    theme_current "$@"
                    ;;
                list)
                    theme_list "$@"
                    ;;
                *)
                    echo "Error: unknown theme command: $command" >&2
                    return 2
                    ;;
            esac
            ;;

        -h|--help)
            usage
            ;;

        -v|--version)
            echo "Singularity 0.1.0"
            ;;

        *)
            echo "Error: unknown command: $1" >&2
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
